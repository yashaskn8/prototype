DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=change-this-for-real-use

# Authoritative MySQL Database Configuration
# MySQL is the primary and authoritative relational database for Servy.
SERVY_DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=servy
MYSQL_USER=servy_app
MYSQL_PASSWORD=change-to-your-mysql-password
MYSQL_CONNECT_TIMEOUT=10
MYSQL_CONN_MAX_AGE=60
# Optional TLS/SSL CA Certificate path:
# MYSQL_SSL_CA=/path/to/ca.pem
SERVY_LLM_PROVIDER=auto
SERVY_OLLAMA_URL=http://127.0.0.1:11434/api/generate
SERVY_OLLAMA_MODEL=qwen2.5:3b
SERVY_RAG_TOP_K=5
SERVY_RAG_MIN_SCORE=0.04

# Starlly API Integration
STARLLY_API_BASE_URL=https://YOUR-ACTUAL-SUBDOMAIN.starlly.in
STARLLY_API_KEY=PASTE_YOUR_SECRET_KEY_HERE
STARLLY_ORGANISATION_ID=273
STARLLY_API_KEY_ID=2

# Optional LOCAL Servy V5 BGE cross-encoder reranking (off by default).
# Never commit downloaded weights; ml_models/checkpoints/ is gitignored.
# Put the FULL best_model directory in the specified location; alternatively
# set SERVY_RERANKER_MODEL_PATH=best_model if it is under prototype/ directly.
# SERVY_RERANKER_ENABLED=1
# SERVY_RERANKER_REQUIRED=1   # strict deployment: refuse startup if V5 cannot score
# SERVY_RERANKER_MODEL_PATH=ml_models/checkpoints/servy_v5/best_model
# SERVY_RERANKER_EXPECTED_SHA256=b1cf23ba0806f0057d73a5ab93fde88d634fc278f71b27f3a2a915afd8f8bcda
# SERVY_RERANKER_DEVICE=cpu
# SERVY_RERANKER_POOL_SIZE=5
# Research-only opt-in: set to 10 only after paired V5 offline pool-size
# evaluation and live CPU/GPU latency/memory checks. Default/serving stays 5.
# SERVY_RERANKER_POOL_SIZE=10
# Note: Qwen3 dense retrieval is a SEPARATE integration, not enabled here.

# EXPERIMENTAL ONLY — Qwen3 embeddings are separate from the V5 reranker.
# Download a complete approved Qwen/Qwen3-Embedding-0.6B snapshot outside Git,
# then create and independently verify the dedicated 1024-D Chroma collection.
# Keep flags OFF until verification succeeds for the chosen tenant profile.
# SERVY_QWEN3_MODEL_PATH=ml_models/checkpoints/qwen3_embedding_0_6b
# SERVY_QWEN3_ENABLED=0
# SERVY_QWEN3_INDEX_VERIFIED=0
# SERVY_USE_EXPERIMENTAL_RAG=0
# SERVY_SERVING_EMBEDDING_PROFILE=qwen3
# SERVY_QWEN3_DENSE_GATE=0.35
# OPTIONAL Qwen3-only accuracy ablation, default OFF. Do not deploy without
# comparing Qwen3 dense-first vs RRF on an independent holdout.
# SERVY_QWEN3_DENSE_FIRST=0
