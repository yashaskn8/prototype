# Copy to /etc/servy/servy-api.env (chmod 600, owner servy). Placeholders only.
DJANGO_SETTINGS_MODULE=servy_rag.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(64))">
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_BEHIND_TLS_PROXY=1
# Backend only: the React client is not served or required.
SERVY_SERVE_FRONTEND=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
# Browser origins of the evaluator portal, only if its browser calls the API directly.
SERVY_CORS_ALLOWED_ORIGINS=
SERVY_CSRF_TRUSTED_ORIGINS=

# MySQL 8.0 (authoritative relational database)
SERVY_DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=servy
MYSQL_USER=servy_app
MYSQL_PASSWORD=<from secret store>
# MYSQL_SSL_CA=/etc/servy/mysql-ca.pem   (when MySQL is on another host)

# Data and models (persist across restarts; back up chroma + media with MySQL)
SERVY_MEDIA_ROOT=/opt/servy/data/media
SERVY_CHROMA_PERSIST_DIR=/opt/servy/data/chroma_db
SERVY_CUSTOMER_DATA_MODE=verified_real_only
SERVY_PRELOAD_MODELS=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/opt/servy/models/hf

# V5 reranker (ONNX on CPU)
SERVY_RERANKER_ENABLED=1
SERVY_RERANKER_REQUIRED=1
SERVY_RERANKER_BACKEND=onnx
SERVY_RERANKER_MODEL_PATH=/opt/servy/models/v5
SERVY_RERANKER_ONNX_DIR=/opt/servy/models/v5_onnx
SERVY_RERANKER_EXPECTED_SHA256=<pinned checkpoint hash>

# Qwen wording through a local Ollama on the same VM (loopback only)
SERVY_SERVING_EMBEDDING_PROFILE=bge-small
SERVY_LLM_PROVIDER=extractive
SERVY_ALLOW_REMOTE_LLM=0
SERVY_CUSTOMER_ANSWER_GENERATION=ollama
SERVY_CUSTOMER_GENERATION_URL=http://127.0.0.1:11434/api/chat
SERVY_CUSTOMER_GENERATION_MODEL=qwen3.5:2b-q4_K_M
SERVY_CUSTOMER_GENERATION_TIMEOUT=45
SERVY_RAG_DEADLINE_SECONDS=5
